{
  // Replace these placeholders with your own agent IDs and visible names.
  "agents": {
    "list": [
      { "id": "agent-a", "name": "Agent-A" },
      { "id": "agent-b", "name": "Agent-B" },
      { "id": "agent-c", "name": "Agent-C" }
    ]
  },

  "channels": {
    "feishu": {
      "accounts": {
        "agent-a": { "name": "Agent-A" },
        "agent-b": { "name": "Agent-B" },
        "agent-c": { "name": "Agent-C" }
      },

      "agentHandoff": {
        "maxRounds": 3,
        "autoReceipt": true,
        "autoComplete": true,

        "taskTemplate": "[System: 这是来自 {sourceDisplayName} 的 agent 协作任务。]\n\n[System: 当前协作轮次 {handoffRound}/{maxRounds}。若需要继续转交其他 agent，不得超过最大轮次。]\n\n[System: 协作顺序、回执策略、汇总方式以当前 agent 的提示词/AGENTS 规则为准；基础收发能力与轮次控制由系统负责。]\n\n{taskBody}",

        "receiptTemplate": "任务已收到，第 {handoffRound} 轮协作开始处理。",

        "completeTemplate": "任务已完成，第 {handoffRound} 轮协作已处理完毕，相关结果已发在群里。"
      }
    }
  }
}
